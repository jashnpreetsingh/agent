# ===========================================================================
# Provider selection: nvidia | openai | gemini
# Both adapters are implemented; everything above src/llm/base.py is
# provider-agnostic. Only the selected provider's key is required.
# ===========================================================================
PROVIDER=nvidia

# --- NVIDIA NIM (default) --------------------------------------------------
# OpenAI-compatible endpoint. Free key at https://build.nvidia.com/
# Serves both the chat model and the embedding model used for RAG ranking.
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenAI (alternative) --------------------------------------------------
# Set PROVIDER=openai. The same adapter serves both NVIDIA and OpenAI; the
# dialect differences are handled by the capability settings further down.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini (alternative) -------------------------------------------
# Free key, no credit card, at https://aistudio.google.com/apikey
# Note: the free tier allows only 5 requests/minute, and one question costs
# 5-8 calls, so expect throttling. The client honours the server's own
# retryDelay, so this appears as latency rather than failure.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Models ----------------------------------------------------------------
# Leave blank to use each provider's defaults:
#   nvidia -> nvidia/nemotron-3.5-lightning-30b-a3b + nvidia/nv-embedqa-e5-v5
#   openai -> gpt-5                                 + text-embedding-3-small
#   gemini -> gemini-3.7-flash                      + gemini-embedding-2
MODEL_NAME=
EMBEDDING_MODEL=
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=16384

# Vendor extension for NVIDIA-hosted reasoning models. Off by default:
# OpenAI rejects unknown parameters with a 400.
ENABLE_THINKING=false
REASONING_BUDGET=8192

# --- Dialect capabilities --------------------------------------------------
# Defaulted per provider; set these only for an endpoint that behaves
# differently from its provider's norm.
#   EMBEDDING_INPUT_TYPE  send input_type/truncate on /embeddings (NVIDIA: yes)
#   MAX_TOKENS_FIELD      max_tokens | max_completion_tokens
#   SEND_TEMPERATURE      omit for OpenAI reasoning models, which reject it
# EMBEDDING_INPUT_TYPE=true
# MAX_TOKENS_FIELD=max_tokens
# SEND_TEMPERATURE=true

# ===========================================================================
# Transport modes: live | record | replay
#   live   - real API calls
#   record - real calls, saved to fixtures/ as cassettes
#   replay - no network, served from fixtures/ (needs no API key)
# ===========================================================================
LLM_MODE=live
PUBMED_MODE=live

# ===========================================================================
# NCBI E-utilities
# The API key is optional and raises the rate limit from 3/s to 10/s:
# https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
# NCBI asks that clients identify themselves with a real contact address.
# ===========================================================================
NCBI_API_KEY=
NCBI_EMAIL=your-email@example.com
NCBI_TOOL=pubmed-evidence-agent

# ===========================================================================
# Budgets - the agent's circuit breakers
# ===========================================================================
MAX_RESEARCH_ITERATIONS=4
MAX_TOOL_CALLS=10
MAX_REVISIONS=1
MAX_EVIDENCE_ITEMS=8
EVIDENCE_CHAR_BUDGET=24000

# ===========================================================================
# Reliability
# Reasoning models writing a full structured answer can exceed 90s, so the
# timeout is generous by default.
# ===========================================================================
REQUEST_TIMEOUT=240
MAX_RETRIES=4
RETRY_BASE_DELAY=1.0
MAX_RETRY_DELAY=65

# Optional extra LLM call classifying whether a question is in scope.
# Off by default. The emergency and personal-advice guards are deterministic
# and always run regardless of this setting.
USE_LLM_SCOPE_CHECK=false

LOG_LEVEL=INFO
